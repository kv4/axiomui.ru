# Переменные bots/.env — сам файл в git не попадает, здесь только шаблон.
# Заполняется на сервере вручную: /home/admin/bots/.env

# ── Почта (единственный канал уведомлений) ──────────────────────────────────
# Обязателен только SMTP_PASS — пароль приложения Яндекс (НЕ обычный пароль от почты).
# Создать: https://id.yandex.ru/security/app-passwords → «Почта» → скопировать.
# Остальные значения уже стоят по умолчанию (smtp.yandex.ru:465, chernyakov.k@yandex.ru).
SMTP_PASS=

# Необязательные переопределения
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=chernyakov.k@yandex.ru
# MAIL_TO=chernyakov.k@yandex.ru
# MAIL_FROM=AxiomUI <chernyakov.k@yandex.ru>
# LEADS_FILE=/home/admin/bots/leads.ndjson

# ── MAX ─────────────────────────────────────────────────────────────────────
MAX_BOT_TOKEN=
